# Base existente de Vivat: el código del panel SOLO realiza SELECT.
SUPABASE_URL=
# Clave secret (sb_secret_...) del proyecto actual; solo servidor.
# También se admite SUPABASE_SERVICE_ROLE_KEY para proyectos con clave legacy.
SUPABASE_SECRET_KEY=

# Proyecto Supabase SEPARADO para gastos y comprobantes:
FINANCE_SUPABASE_URL=
FINANCE_SUPABASE_SECRET_KEY=

# Acceso privado del equipo (obligatorio en producción y para registrar gastos):
PANEL_USERNAME=
PANEL_PASSWORD=

# Compatible con NEXT_PUBLIC_GA_PROPERTY_ID del entorno existente:
GA_PROPERTY_ID=
# Elegir una opción: JSON de cuenta de servicio o ruta al archivo.
GOOGLE_ANALYTICS_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/privada/google-credentials.json
# Sin estas variables, se utiliza ./google-credentials.json (ignorado por Git).
# Completar únicamente al confirmar el nombre instrumentado en la app:
GA_APPLICATION_EVENT=
